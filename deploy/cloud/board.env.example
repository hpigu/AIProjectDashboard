# Non-secret systemd EnvironmentFile. Install as /etc/ai-project-board/board.env.
# Replace both example hosts; keep the two hostnames distinct.
BOARD_HOST=127.0.0.1
BOARD_PORT=18081
BOARD_CLOUD_ENABLED=true
BOARD_CLOUD_WEB_HOST=board.example.com
BOARD_CLOUD_MCP_HOST=mcp.example.com
BOARD_ALLOWED_HOSTS=board.example.com,mcp.example.com
SERVER_FORWARD_HEADERS_STRATEGY=none
BOARD_HOME_DIR=/var/lib/ai-project-board
BOARD_DB_URL=jdbc:h2:file:/var/lib/ai-project-board/data/board;DB_CLOSE_ON_EXIT=FALSE
BOARD_LOG_FILE=/var/log/ai-project-board/board.log
BOARD_BACKUP_DIR=/var/lib/ai-project-board/backups
BOARD_BACKUP_INTERVAL=1h
BOARD_BACKUP_SCHEDULE_ENABLED=true
BOARD_BACKUP_RETENTION_DAYS=30
BOARD_BACKUP_RETENTION_MIN_COUNT=7
