#!/usr/bin/env bash
# board — 看板的服務生命週期入口（start / stop / restart / status / logs / update）
#
# 這支腳本是 mac 與 Linux 上唯一的服務入口，對稱於 Windows 的 bin\board.ps1。
# 兩邊的形狀刻意一致：每個平台各一支主入口（board / board.ps1）、一份共用預設值
# （board-env.sh / board-env.ps1）、一支備份（backup-db.*）與一支還原（restore-db.*）。
#
# start 這件事本身以前住在獨立的 bin/start-board.sh，只有 bash 側這樣切，Windows
# 側從一開始就是合併的。兩邊形狀不一致沒有帶來任何好處，只讓「我到底該執行哪一支」
# 變成一個需要查文件的問題，因此已經併回這裡。
#
# 為什麼 stop 不直接 kill：
#   1. 使用者猜錯 PID 就殺到別的 Java 行程；
#   2. 圖快用 kill -9，而 SIGKILL 不給 ShutdownBackupService 任何機會執行，
#      關閉前的一致性備份直接消失（見 README「安全啟動、備份與診斷」）。
# 因此 stop 一律先送 SIGTERM 並等待，確認行程是看板本身才動手，
# 且絕不自動升級成 SIGKILL——要強制終止必須由使用者明確加上 --force。
#
# start 在啟動前防住三個實測踩過的坑：
#   1. jar 從 target/ 啟動時，相對路徑 ./data/board 會解析成 target/data/board，
#      連到全新空庫 —— 一律用「絕對路徑指向 repo 根目錄的 data/」。
#   2. 舊行程沒退乾淨，H2 檔案被鎖，只拋 MVStoreException 堆疊 —— 啟動前先
#      偵測鎖檔行程並直接告知 PID，不要讓 Java 丟一坨堆疊給使用者猜。
#   3. 系統預設 Java 版本不是 21（本機 /usr/libexec/java_home 預設是 11）——
#      掃過所有已安裝 JDK 找 21，找不到才給出對應平台的安裝指令。
#
# 不可假設目前工作目錄是 repo 根目錄；一律用腳本自身路徑（BASH_SOURCE）反推
# repo 根目錄與 jar 路徑。下方第 0 節保留 symlink 解析迴圈，讓使用者自行建立的
# symlink 也能正確解到真正的 repo 根目錄。
#
# 可用環境變數（路徑與埠號的預設值全部來自 bin/board-env.sh）：
#   BOARD_PORT     預設 8080
#   BOARD_DB_URL   預設 jdbc:h2:file:<db-dir>/board;DB_CLOSE_ON_EXIT=FALSE
#                  <db-dir> 預設為 <repo>/data（如果該路徑已有既有資料庫，
#                  向下相容用），否則為 ~/.ai-project-board/data（全新環境，
#                  避免資料放在可能被 plugin 更新覆蓋的目錄下）
#   BOARD_HOME_DIR 預設 ~/.ai-project-board，決定上述全新環境的資料目錄位置
#   BOARD_DB_USER / BOARD_DB_PASSWORD
#   BOARD_LOG_FILE 預設 <repo>/logs/board.log
#   BOARD_JAR      指定要啟動的 jar 路徑（預設自動尋找 target/*.jar，
#                  找不到且 repo 根目錄有 pom.xml + mvnw 時會現場組裝一次）
#   BOARD_BACKUP_DIR         啟動前冷備份輸出目錄，預設 <BOARD_HOME_DIR>/backups
#   BOARD_PID_FILE           預設 <BOARD_HOME_DIR>/board.pid
#   BOARD_CONSOLE_LOG        行程 stdout/stderr，預設 <BOARD_LOG_FILE>.console
#   BOARD_START_TIMEOUT_SEC  start 等待服務就緒的秒數（預設 60）
#   BOARD_STOP_TIMEOUT_SEC   stop 等待行程結束的秒數（預設 60）

set -u

# ---------------------------------------------------------------------------
# 0. 定位 repo 根目錄（腳本放在 <repo>/bin/ 下）
# ---------------------------------------------------------------------------
SCRIPT_SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SCRIPT_SOURCE" ]; do
  SCRIPT_DIR="$(cd -P "$(dirname "$SCRIPT_SOURCE")" >/dev/null 2>&1 && pwd)"
  SCRIPT_SOURCE="$(readlink "$SCRIPT_SOURCE")"
  [[ $SCRIPT_SOURCE != /* ]] && SCRIPT_SOURCE="$SCRIPT_DIR/$SCRIPT_SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SCRIPT_SOURCE")" >/dev/null 2>&1 && pwd)"
REPO_ROOT="$(cd -P "$SCRIPT_DIR/.." >/dev/null 2>&1 && pwd)"

log()  { printf '[board] %s\n' "$*"; }
err()  { printf '[board][錯誤] %s\n' "$*" >&2; }

# 埠號、資料庫、日誌、PID 檔的預設值全部定義在 bin/board-env.sh（含「既有 repo
# 資料目錄 vs 全新環境家目錄」兩種情境的完整說明），由本腳本與 bin/restore-db.sh
# 共用。抽出去的原因：兩者必須對「資料庫／PID／日誌在哪」有一致認知，否則會出現
# start 起在 A 庫、restore 還原到 B 庫這類最難查的錯誤。
# shellcheck source=bin/board-env.sh
source "${SCRIPT_DIR}/board-env.sh"

START_TIMEOUT_SEC="${BOARD_START_TIMEOUT_SEC:-60}"
STOP_TIMEOUT_SEC="${BOARD_STOP_TIMEOUT_SEC:-60}"

usage() {
  cat <<EOF
用法：board <指令> [選項]

指令：
  start              啟動看板（JDK 偵測、埠號與鎖檔檢查、啟動前備份、
                     必要時現場組裝 jar）
  stop [--force]     送 SIGTERM 停止看板並等待關閉前備份完成。逾時後預設不會
                     強制終止；--force 才會在等待逾時後送 SIGKILL（會失去
                     關閉前備份）
  restart            stop 後再 start
  status             顯示 PID、埠號與 /api/health 版本資訊
  logs [-n N]        追蹤日誌（tail -f）；-n 指定先顯示的行數，預設 50
  update ...         明確指定 stable vV 的交易式更新；詳見 board update --help

還原資料庫請用 bin/restore-db.sh——它必須在看板停止的狀態下執行，且會覆寫
資料庫檔，刻意不放進這個天天使用的入口。

環境變數：
  BOARD_PORT               預設 8080
  BOARD_PID_FILE           預設 ${BOARD_HOME_DIR}/board.pid
  BOARD_LOG_FILE           預設 <repo>/logs/board.log
  BOARD_START_TIMEOUT_SEC  start 等待秒數，預設 60
  BOARD_STOP_TIMEOUT_SEC   stop 等待秒數，預設 60

離開碼：
  0  指令成功（status：看板正在執行）
  1  指令失敗
  3  status 專用：看板未在執行
EOF
}

# ---------------------------------------------------------------------------
# 解析目前的看板 PID。
#
# 兩個來源，順序有意義：
#   1. PID 檔——由 start 寫入，最準確。
#   2. 埠號反查——PID 檔遺失（手動 java -jar 起、家目錄被清掉）時的後備。
# 兩者都會經過 board_pid_is_board() 確認行程真的是看板，避免 PID 被回收後
# 對無關行程動手。找不到時回傳非 0，不輸出任何內容。
# ---------------------------------------------------------------------------
resolve_pid() {
  local pid
  if pid="$(board_read_pid_file)"; then
    printf '%s' "$pid"
    return 0
  fi

  if pid="$(board_pid_from_port)" && board_pid_is_board "$pid"; then
    printf '%s' "$pid"
    return 0
  fi

  return 1
}

# JVM 已經由本次 start 啟動、但後續的安全收尾失敗時，不能只讓啟動腳本退出：
# 那會留下沒有可信 PID 檔可管理、卻仍持有資料庫的孤兒行程。這裡只操作由 `$!`
# 當場記下的確切 PID，絕不以名稱或命令列子字串搜尋行程。
#
# 先送 SIGTERM，讓 Spring 有機會正常關閉；逾時才對同一個確切 PID 送 SIGKILL。
# 這和使用者主動執行 stop 的語意不同：stop 預設不強制終止健康、已受 PID 檔管理
# 的服務；此處是啟動交易尚未完成，不能把未受管理的子行程留在系統裡。
abort_started_process() {
  local pid="$1"
  local reason="$2"
  local elapsed=0
  local cleanup_timeout="$STOP_TIMEOUT_SEC"
  [[ "$cleanup_timeout" =~ ^[0-9]+$ ]] || cleanup_timeout=60

  err "$reason"
  err "啟動交易未完成，正在終止本次啟動的確切 PID=${pid}，避免留下孤兒行程。"

  if kill -0 "$pid" 2>/dev/null; then
    if ! kill -TERM "$pid" 2>/dev/null; then
      if kill -0 "$pid" 2>/dev/null; then
        err "無法對本次啟動的 PID=${pid} 送出 SIGTERM；仍會等待並只對同一個確切 PID 做後續收尾。"
      fi
    fi
  fi

  while kill -0 "$pid" 2>/dev/null && [ "$elapsed" -lt "$cleanup_timeout" ]; do
    sleep 1
    elapsed=$((elapsed + 1))
  done

  if kill -0 "$pid" 2>/dev/null; then
    err "PID=${pid} 在 ${cleanup_timeout} 秒後仍未結束；啟動交易無法安全完成，改對同一個確切 PID 送出 SIGKILL。"
    force_kill_exact_pid "$pid"
    sleep 1
  fi

  if kill -0 "$pid" 2>/dev/null; then
    err "SIGKILL 後 PID=${pid} 仍存在；未使用名稱比對清理，請手動確認這個確切 PID。"
    return 1
  fi

  # disown 前失敗時它仍是目前 shell 的子行程；盡力 reap，避免短暫 zombie。
  wait "$pid" 2>/dev/null || true
  if [ -f "$BOARD_PID_FILE" ]; then
    local recorded_pid
    recorded_pid="$(head -n1 "$BOARD_PID_FILE" 2>/dev/null | tr -d '[:space:]')"
    [ "$recorded_pid" = "$pid" ] && rm -f -- "$BOARD_PID_FILE"
  fi
  log "已終止本次啟動的 PID=${pid}；未留下未受管理的看板行程。"
  return 0
}

# ---------------------------------------------------------------------------
# JDK 偵測：找 21，找不到給出對應平台安裝指令
# ---------------------------------------------------------------------------
version_is_21() {
  # 傳入 java 執行檔路徑，回傳 0 代表版本為 21.x
  local candidate="$1"
  [ -x "$candidate" ] || return 1
  local ver
  # 不能直接取第一行：JVM 會把 JAVA_TOOL_OPTIONS／_JAVA_OPTIONS 的
  # "Picked up ..." 提示印在版本字串之前（企業 proxy、IDE、容器映像常設這兩個
  # 變數），此時第一行根本不含版本號，JDK 21 會被誤判成「沒安裝」。改成挑出
  # 真正帶 version "..." 的那一行再比對。
  ver="$("$candidate" -version 2>&1 | grep -F 'version "' | head -n1)"
  [[ "$ver" == *'"21'* ]]
}

find_java21_macos() {
  local home
  # 1) java_home -v 21 最準
  if home="$(/usr/libexec/java_home -v 21 2>/dev/null)"; then
    if version_is_21 "$home/bin/java"; then
      echo "$home/bin/java"
      return 0
    fi
  fi
  # 2) java_home -V 掃全部已註冊的 JDK（涵蓋 java_home 預設回傳非 21 的情況）
  if command -v /usr/libexec/java_home >/dev/null 2>&1; then
    local line jhome
    while IFS= read -r line; do
      jhome="$(printf '%s' "$line" | sed -n 's/.*" \(\/[^"]*\)$/\1/p')"
      [ -n "$jhome" ] || continue
      if version_is_21 "$jhome/bin/java"; then
        echo "$jhome/bin/java"
        return 0
      fi
    done < <(/usr/libexec/java_home -V 2>&1 | grep -E '^\s+[0-9]')
  fi
  # 3) Homebrew 常見安裝路徑（java_home 未必有註冊到，例如僅 brew install 未 link）
  local brew_candidates=(
    "/opt/homebrew/opt/openjdk@21/bin/java"
    "/opt/homebrew/opt/openjdk/bin/java"
    "/usr/local/opt/openjdk@21/bin/java"
    "/usr/local/opt/openjdk/bin/java"
  )
  local c
  for c in "${brew_candidates[@]}"; do
    if version_is_21 "$c"; then
      echo "$c"
      return 0
    fi
  done
  return 1
}

find_java21_linux() {
  local c
  # update-alternatives 列出的候選
  if command -v update-alternatives >/dev/null 2>&1; then
    while IFS= read -r c; do
      [ -n "$c" ] || continue
      if version_is_21 "$c"; then
        echo "$c"
        return 0
      fi
    done < <(update-alternatives --list java 2>/dev/null)
  fi
  # 常見安裝路徑
  local dir
  for dir in /usr/lib/jvm/*21* /usr/lib/jvm/java-21* /opt/java/*21*; do
    [ -d "$dir" ] || continue
    if version_is_21 "$dir/bin/java"; then
      echo "$dir/bin/java"
      return 0
    fi
  done
  return 1
}

suggest_install_cmd() {
  case "$(uname -s)" in
    Darwin)
      cat >&2 <<'EOF'
找不到 JDK 21。安裝方式（擇一）：
  brew install openjdk@21
  # 安裝後如果 /usr/libexec/java_home -V 仍未列出，可執行：
  sudo ln -sfn /opt/homebrew/opt/openjdk@21/libexec/openjdk.jdk \
    /Library/Java/JavaVirtualMachines/openjdk-21.jdk
EOF
      ;;
    Linux)
      cat >&2 <<'EOF'
找不到 JDK 21。安裝方式（依發行版擇一）：
  sudo apt-get update && sudo apt-get install -y openjdk-21-jdk   # Debian/Ubuntu
  sudo dnf install -y java-21-openjdk-devel                       # Fedora/RHEL
  sudo pacman -S jdk21-openjdk                                    # Arch
EOF
      ;;
    *)
      echo "找不到 JDK 21，請至 https://adoptium.net/ 下載對應平台的 21 版本。" >&2
      ;;
  esac
}

# ---------------------------------------------------------------------------
# 找 jar
#
# jar 不進版控（59MB 二進位檔不適合放進 git），因此 target/*.jar 在全新 clone
# （例如透過 plugin 安裝）下不存在。找不到時，若 repo 根目錄有 pom.xml 與 mvnw
# （代表這是完整 repo，不是零散的 plugin 目錄），自動執行一次
# `./mvnw package -DskipTests` 現場組裝，不需要另外維護 release 組裝流程或把
# 二進位檔提交進 git。
# ---------------------------------------------------------------------------
find_jar() {
  # 依版號而非字典序挑最新的一份，見 board-env.sh 的 board_sort_jars_by_version。
  find "${REPO_ROOT}/target" -maxdepth 1 -name '*.jar' ! -name '*.original' 2>/dev/null \
    | board_sort_jars_by_version \
    | tail -n1
}

cmd_start() {
  log "repo 根目錄：$REPO_ROOT"

  # JVM 與其所有子系統都繼承 077。這使 H2／Logback 之後建立或重建的資料庫、
  # active log 與 rolling log 從誕生時就是 0600，而不是只在啟動當下 chmod 一次。
  board_set_secure_umask

  # -------------------------------------------------------------------------
  # 1. JDK 偵測
  # -------------------------------------------------------------------------
  local JAVA_BIN=""
  # 先看目前 PATH 上的 java 是不是剛好就是 21（多數情況最快）
  if command -v java >/dev/null 2>&1 && version_is_21 "$(command -v java)"; then
    JAVA_BIN="$(command -v java)"
  else
    case "$(uname -s)" in
      Darwin) JAVA_BIN="$(find_java21_macos || true)" ;;
      Linux)  JAVA_BIN="$(find_java21_linux || true)" ;;
      *) ;;
    esac
  fi

  if [ -z "$JAVA_BIN" ]; then
    err "系統上找不到 JDK 21（專案 pom.xml 要求 java.version=21）。"
    suggest_install_cmd
    exit 1
  fi

  log "使用 JDK 21：${JAVA_BIN}（$("$JAVA_BIN" -version 2>&1 | head -n1)）"

  # -------------------------------------------------------------------------
  # 2. 環境變數與絕對路徑資料庫（預設值來自已 source 的 board-env.sh）
  #
  #    目錄依實際解析出的 BOARD_DB_URL（而非固定的預設路徑）建立並收斂為僅
  #    目前使用者可存取（0700）；新建目錄收斂失敗會中止啟動（fail closed），
  #    因為此時目錄裡還沒有任何使用者資料。JVM 啟動後
  #    SensitiveDirectoryEnvironmentPostProcessor 會在 DataSource 初始化前
  #    再次確認同一目錄的權限，這裡先做一次是為了在資料庫檔案於此目錄下
  #    誕生之前，目錄本身就已經是嚴格權限，不留任何窗口。
  # -------------------------------------------------------------------------
  local DB_DIR_TO_SECURE
  DB_DIR_TO_SECURE="$(dirname "$(board_db_file_path)")"
  [ -n "${BOARD_DB_USER:-}" ] && export BOARD_DB_USER
  [ -n "${BOARD_DB_PASSWORD:-}" ] && export BOARD_DB_PASSWORD

  if [ -n "$DB_DIR_TO_SECURE" ] && [ "$DB_DIR_TO_SECURE" != "." ]; then
    if ! board_secure_dir "$DB_DIR_TO_SECURE"; then
      exit 1
    fi
  fi

  log "BOARD_PORT=${BOARD_PORT}"
  log "BOARD_DB_URL=$(board_mask_db_url "$BOARD_DB_URL")"
  log "BOARD_LOG_FILE=${BOARD_LOG_FILE}"

  # -------------------------------------------------------------------------
  # 3. 埠號檢查：被佔用時判斷是不是看板自己
  # -------------------------------------------------------------------------
  local PORT_PID=""
  if command -v lsof >/dev/null 2>&1; then
    PORT_PID="$(lsof -nP -iTCP:"${BOARD_PORT}" -sTCP:LISTEN -t 2>/dev/null | head -n1)"
  fi

  if [ -n "$PORT_PID" ]; then
    log "埠號 ${BOARD_PORT} 已被 PID ${PORT_PID} 佔用，檢查是否為看板本身……"
    if command -v curl >/dev/null 2>&1 && curl -s -o /dev/null -w '%{http_code}' \
        --max-time 3 "http://127.0.0.1:${BOARD_PORT}/api/projects" 2>/dev/null | grep -q '^2'; then
      log "偵測到看板已在 :${BOARD_PORT} 正常運作（PID ${PORT_PID}），不重複啟動。"
      # 補寫 PID 檔：看板可能是舊版腳本或手動 java -jar 起的，補上之後
      # `bin/board stop` 才停得掉，不必叫使用者自己 ps | grep。此路徑是盡力而為
      # 的補救（看板其實已在正常運作），權限收斂失敗不阻擋這裡繼續，僅記錄。
      board_secure_dir "$(dirname "$BOARD_PID_FILE")" || true
      printf '%s\n' "$PORT_PID" > "$BOARD_PID_FILE" 2>/dev/null || true
      board_secure_file "$BOARD_PID_FILE" 1 || true
      exit 0
    else
      err "埠號 ${BOARD_PORT} 被其他行程佔用（PID ${PORT_PID}，非本看板服務）。"
      err "請先確認該行程用途，或改用 BOARD_PORT 指定其他埠號再重試。"
      exit 1
    fi
  fi

  # -------------------------------------------------------------------------
  # 4. H2 檔案鎖偵測：不要讓 MVStoreException 堆疊糊弄使用者
  # -------------------------------------------------------------------------
  local DB_FILE_PATH DB_MV_FILE LOCK_PIDS
  DB_FILE_PATH="$(board_db_file_path)"
  board_secure_runtime_files \
    "${DB_FILE_PATH:+${DB_FILE_PATH}.mv.db}" "$BOARD_LOG_FILE" "$BOARD_CONSOLE_LOG"
  if [ -n "$DB_FILE_PATH" ]; then
    DB_MV_FILE="${DB_FILE_PATH}.mv.db"
    if [ -e "$DB_MV_FILE" ] && command -v lsof >/dev/null 2>&1; then
      LOCK_PIDS="$(lsof -nP -t -- "$DB_MV_FILE" 2>/dev/null | sort -u | tr '\n' ' ')"
      if [ -n "${LOCK_PIDS// /}" ]; then
        err "資料庫檔 ${DB_MV_FILE} 目前被下列 PID 持有中，啟動會失敗（MVStoreException）："
        err "  PID: ${LOCK_PIDS}"
        err "請先確認並結束該行程（例如：kill ${LOCK_PIDS}），再重新執行本腳本。"
        exit 1
      fi
    fi
  fi

  # -------------------------------------------------------------------------
  # 5. 啟動前冷備份：資料庫已存在且未被其他行程持有（上一步已確認）時，
  #    在 jar 啟動、Flyway migration 跑之前先建立一份快照。備份失敗必須
  #    中止啟動，不可讓 migration 在沒有備份可還原的情況下繼續。
  #
  #    資料庫不存在（全新環境首次啟動）不算失敗，直接略過，見
  #    bin/backup-db.sh 內 backup_database() 的說明。
  # -------------------------------------------------------------------------
  # shellcheck source=bin/backup-db.sh
  source "${SCRIPT_DIR}/backup-db.sh"

  if [ -n "${DB_FILE_PATH:-}" ]; then
    if ! backup_database "${DB_FILE_PATH}.mv.db" "$BOARD_BACKUP_DIR"; then
      err "啟動前資料庫備份失敗，為避免在無可還原快照的情況下執行 migration，中止啟動。"
      exit 1
    fi
  fi

  # -------------------------------------------------------------------------
  # 6. 找 jar（找不到就現場組裝一次）
  # -------------------------------------------------------------------------
  local JAR_PATH
  if [ -n "${BOARD_JAR:-}" ]; then
    JAR_PATH="$BOARD_JAR"
  else
    JAR_PATH="$(find_jar)"
  fi

  if [ -z "${JAR_PATH:-}" ] || [ ! -f "$JAR_PATH" ]; then
    if [ -f "${REPO_ROOT}/pom.xml" ] && [ -x "${REPO_ROOT}/mvnw" ]; then
      log "找不到可執行 jar，偵測到完整 repo（pom.xml + mvnw），現場組裝一次……"
      log "（首次啟動需下載 Maven 依賴並編譯，可能需要數分鐘）"
      if ! (cd "${REPO_ROOT}" && ./mvnw package -DskipTests); then
        err "自動組裝失敗，請至 ${REPO_ROOT} 手動執行：./mvnw package -DskipTests"
        exit 1
      fi
      JAR_PATH="$(find_jar)"
    fi
  fi

  if [ -z "${JAR_PATH:-}" ] || [ ! -f "$JAR_PATH" ]; then
    err "找不到可執行 jar（${REPO_ROOT}/target/*.jar），自動組裝亦不可用。"
    err "請先在 repo 根目錄執行：./mvnw package -DskipTests"
    exit 1
  fi

  log "啟動 jar：${JAR_PATH}"
  board_secure_dir "$(dirname "$BOARD_LOG_FILE")" || exit 1
  board_secure_dir "$(dirname "$BOARD_PID_FILE")" || exit 1

  # -------------------------------------------------------------------------
  # 7. 背景啟動
  #
  # nohup + 重導向 + disown：讓行程脫離啟動它的終端機。
  #
  # 舊版直接用 `&` 起子行程後腳本就結束，行程仍掛在終端機的 session 上——關掉終端機
  # 視窗會送出 SIGHUP 直接殺掉看板。那個路徑不只是「服務沒了」：SIGHUP 預設行為
  # 是立即終止，ShutdownBackupService 的關閉前備份也一起沒了。nohup 讓行程忽略
  # SIGHUP，disown 再把它從 shell 的 job table 移除，兩者一起才真的斷乾淨。
  #
  # stdout/stderr 導到 BOARD_CONSOLE_LOG 而非 /dev/null：logback 初始化之前的失敗
  # （JVM 參數錯誤、埠號綁不上的原始堆疊）只會出現在 stdout，丟掉的話啟動失敗時
  # 使用者會完全看不到原因。
  # -------------------------------------------------------------------------
  local APP_PID
  local CONSOLE_LOG_IS_NEW=0
  [ -e "$BOARD_CONSOLE_LOG" ] || CONSOLE_LOG_IS_NEW=1
  nohup "$JAVA_BIN" -jar "$JAR_PATH" >> "$BOARD_CONSOLE_LOG" 2>&1 &
  APP_PID=$!
  # console log 可能含 JVM 參數錯誤等診斷資訊，收斂為僅目前使用者可讀寫；
  # 既有檔案（重啟後續寫）收斂失敗不阻擋啟動，只記錄警告。
  if ! board_secure_file "$BOARD_CONSOLE_LOG" "$CONSOLE_LOG_IS_NEW"; then
    abort_started_process "$APP_PID" \
      "無法安全收斂本次新建的 console log，已中止啟動：${BOARD_CONSOLE_LOG}"
    exit 1
  fi
  if ! printf '%s\n' "$APP_PID" > "$BOARD_PID_FILE"; then
    abort_started_process "$APP_PID" \
      "無法寫入 PID 檔，已中止啟動：${BOARD_PID_FILE}"
    exit 1
  fi
  if ! board_secure_file "$BOARD_PID_FILE" 1; then
    abort_started_process "$APP_PID" \
      "無法安全收斂本次寫入的 PID 檔，已中止啟動：${BOARD_PID_FILE}"
    exit 1
  fi
  disown "$APP_PID" 2>/dev/null || true
  log "已啟動子行程 PID=${APP_PID}（PID 檔：${BOARD_PID_FILE}），等待服務就緒……"

  # -------------------------------------------------------------------------
  # 8. 啟動確認：輪詢 /api/projects 直到回應或逾時
  # -------------------------------------------------------------------------
  local ELAPSED=0 READY=0
  while [ "$ELAPSED" -lt "$START_TIMEOUT_SEC" ]; do
    if ! kill -0 "$APP_PID" 2>/dev/null; then
      err "行程 PID=${APP_PID} 已提前結束，啟動失敗。請查看 ${BOARD_LOG_FILE}"
      err "以及 logback 初始化前的輸出：${BOARD_CONSOLE_LOG}。"
      rm -f "$BOARD_PID_FILE"
      exit 1
    fi
    if command -v curl >/dev/null 2>&1 && curl -s -o /dev/null -w '%{http_code}' \
        --max-time 2 "http://127.0.0.1:${BOARD_PORT}/api/projects" 2>/dev/null | grep -q '^2'; then
      READY=1
      break
    fi
    sleep 1
    ELAPSED=$((ELAPSED + 1))
  done

  if [ "$READY" -ne 1 ]; then
    err "等待 ${START_TIMEOUT_SEC} 秒後仍未就緒（PID=${APP_PID}）。請查看 ${BOARD_LOG_FILE}。"
    err "行程仍在執行中，PID 檔保留於 ${BOARD_PID_FILE}，可用 bin/board stop 停止。"
    exit 1
  fi

  log "看板已就緒：http://127.0.0.1:${BOARD_PORT}（PID=${APP_PID}）"

  # -------------------------------------------------------------------------
  # 9. 版本自我檢查：印出 /api/health，讓「手上跑的其實是舊 build」這類問題一眼
  #    可辨（實測踩過：行程啟動時間早於某次 commit，導致新端點回 404 卻讓人誤以為
  #    端點沒做）。舊版行程沒有 /api/health（404）是正常情況，僅提示、不視為失敗。
  # -------------------------------------------------------------------------
  local HEALTH_JSON
  if command -v curl >/dev/null 2>&1; then
    HEALTH_JSON="$(curl -s --max-time 3 "http://127.0.0.1:${BOARD_PORT}/api/health" 2>/dev/null)"
    if [ -n "$HEALTH_JSON" ] && printf '%s' "$HEALTH_JSON" | grep -q '"version"'; then
      log "版本資訊：${HEALTH_JSON}"
    else
      log "此行程沒有 /api/health（可能是較舊的 build），略過版本檢查。"
    fi
  fi

  return 0
}

cmd_stop() {
  local force=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --force) force=1 ;;
      *) err "stop 不認識的選項：$1"; return 1 ;;
    esac
    shift
  done

  local pid
  if ! pid="$(resolve_pid)"; then
    # PID 檔可能是上次沒清乾淨的殘留；順手清掉，讓下次 status 不再誤報。
    if [ -f "$BOARD_PID_FILE" ]; then
      log "PID 檔存在但行程已不在（殘留），清除：${BOARD_PID_FILE}"
      rm -f "$BOARD_PID_FILE"
    fi
    log "看板未在執行，無需停止。"
    return 0
  fi

  log "停止看板（PID=${pid}）……送出 SIGTERM，等待關閉前備份完成。"
  if ! kill -TERM "$pid" 2>/dev/null; then
    err "送出 SIGTERM 失敗（PID=${pid}）：可能權限不足或行程剛結束。"
    return 1
  fi

  local elapsed=0
  while [ "$elapsed" -lt "$STOP_TIMEOUT_SEC" ]; do
    if ! kill -0 "$pid" 2>/dev/null; then
      rm -f "$BOARD_PID_FILE"
      log "已停止（PID=${pid}，耗時 ${elapsed} 秒）。關閉前備份見 ${BOARD_BACKUP_DIR}。"
      return 0
    fi
    sleep 1
    elapsed=$((elapsed + 1))
    # 大型資料庫的 BACKUP TO 可能需要數十秒，過程中給出進度而不是靜默等待。
    if [ $((elapsed % 10)) -eq 0 ]; then
      log "仍在關閉中……（已等待 ${elapsed}／${STOP_TIMEOUT_SEC} 秒）"
    fi
  done

  if [ "$force" -eq 1 ]; then
    err "等待 ${STOP_TIMEOUT_SEC} 秒仍未結束，依 --force 送出 SIGKILL。"
    err "注意：SIGKILL 不會執行關閉前備份，本次停止沒有一致性快照。"
    force_kill_exact_pid "$pid"
    sleep 1
    if kill -0 "$pid" 2>/dev/null; then
      err "SIGKILL 後行程仍存在（PID=${pid}），請手動確認。"
      return 1
    fi
    rm -f "$BOARD_PID_FILE"
    log "已強制終止（PID=${pid}）。"
    return 0
  fi

  err "等待 ${STOP_TIMEOUT_SEC} 秒後行程 PID=${pid} 仍在執行，已放棄等待（未強制終止）。"
  err "刻意不自動送 SIGKILL：那會中斷關閉前備份。可先查看 ${BOARD_LOG_FILE} 確認"
  err "是否正在進行備份；確定要強制終止再執行：bin/board stop --force"
  return 1
}

# 集中唯一一處 SIGKILL 實作，讓 stop --force 與「啟動交易失敗後不得留下孤兒」
# 共用同一條只接受確切 PID 的路徑。呼叫端必須先完成自己的 TERM／等待／診斷語意。
force_kill_exact_pid() {
  local pid="$1"
  kill -KILL "$pid" 2>/dev/null || true
}

cmd_restart() {
  cmd_stop || return 1
  # 停止後 H2 需要一點時間釋放檔案鎖；沒有這段間隔，start 有機會撞上
  # MVStoreException（正是 cmd_start 第 4 節在防的那個坑）。
  sleep 1
  cmd_start
}

cmd_status() {
  local pid=""
  local running=1
  if pid="$(resolve_pid)"; then
    running=0
  fi

  if [ "$running" -eq 0 ]; then
    log "行程：執行中（PID=${pid}）"
  else
    log "行程：未執行"
  fi

  log "PID 檔：${BOARD_PID_FILE}$([ -f "$BOARD_PID_FILE" ] || printf '（不存在）')"
  log "埠號：${BOARD_PORT}"
  log "資料庫：$(board_mask_db_url "$BOARD_DB_URL")"
  log "日誌：${BOARD_LOG_FILE}"

  if board_http_ready 3; then
    log "HTTP：/api/health/live 正常回應"
    if command -v curl >/dev/null 2>&1; then
      local health
      health="$(curl -s --max-time 3 "http://127.0.0.1:${BOARD_PORT}/api/health" 2>/dev/null)"
      [ -n "$health" ] && log "版本資訊：${health}"
    fi
  else
    log "HTTP：沒有回應（服務未啟動，或仍在啟動中）"
  fi

  # 行程在、但 HTTP 不通也算「未就緒」；status 的離開碼以「服務可用」為準，
  # 方便寫進其他腳本或監控。
  if [ "$running" -eq 0 ] && board_http_ready 3; then
    return 0
  fi
  return 3
}

cmd_logs() {
  local lines=50
  while [ $# -gt 0 ]; do
    case "$1" in
      -n) shift; lines="${1:-50}" ;;
      *) err "logs 不認識的選項：$1"; return 1 ;;
    esac
    shift
  done

  if [ ! -f "$BOARD_LOG_FILE" ]; then
    err "日誌檔不存在：${BOARD_LOG_FILE}（看板可能尚未啟動過）"
    return 1
  fi

  log "追蹤 ${BOARD_LOG_FILE}（Ctrl+C 結束）"
  tail -n "$lines" -f "$BOARD_LOG_FILE"
}

COMMAND="${1:-}"
[ $# -gt 0 ] && shift

case "$COMMAND" in
  start)   cmd_start "$@" ;;
  stop)    cmd_stop "$@" ;;
  restart) cmd_restart "$@" ;;
  status)  cmd_status "$@" ;;
  logs)    cmd_logs "$@" ;;
  update)  exec "${SCRIPT_DIR}/board-update.sh" "$@" ;;
  ''|-h|--help|help) usage ;;
  *) err "不認識的指令：${COMMAND}"; echo; usage >&2; exit 1 ;;
esac
