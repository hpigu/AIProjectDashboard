{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-project-board-mcp",
  "main": "src/index.js",
  "compatibility_date": "2026-11-04",
  "compatibility_flags": ["enable_request_signal"],
  "workers_dev": true,
  "preview_urls": false,
  "send_metrics": false,
  "observability": { "enabled": false },
  "dev": { "ip": "127.0.0.1", "port": 18788 },
  "vars": { "BOARD_MODE": "mcp", "BOARD_MAINTENANCE": "false" },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "ai-project-board",
    "database_id": "00000000-0000-4000-8000-000000000001",
    "migrations_dir": "migrations",
    "remote": false
  }]
}
