{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-project-board-web",
  "main": "src/index.js",
  "compatibility_date": "2026-11-04",
  "compatibility_flags": ["enable_request_signal"],
  "workers_dev": true,
  "preview_urls": false,
  "send_metrics": false,
  "observability": { "enabled": false },
  "dev": { "ip": "127.0.0.1", "port": 18787 },
  "assets": {
    "directory": "../src/main/resources/static",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "BOARD_MODE": "web",
    "BOARD_CAPACITY_BACKEND": "3",
    "BOARD_CAPACITY_FRONTEND": "1",
    "BOARD_CAPACITY_TEST": "1",
    "BOARD_CAPACITY_INFRA": "1",
    "BOARD_CAPACITY_DOC": "1",
    "MCP_PUBLIC_URL": "https://REPLACE_MCP_HOST/mcp",
    "CLOUDFLARE_ACCESS_TEAM": "REPLACE_TEAM_SLUG",
    "CLOUDFLARE_ACCESS_AUD": "REPLACE_WEB_ACCESS_AUD",
    "OWNER_EMAIL": "REPLACE_OWNER_EMAIL"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "ai-project-board",
    "database_id": "00000000-0000-4000-8000-000000000001",
    "migrations_dir": "migrations",
    "remote": false
  }]
}
